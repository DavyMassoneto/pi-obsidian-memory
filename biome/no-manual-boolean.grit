language js

or {
  `$value === true`,
  `$value === false`,
  `$value !== true`,
  `$value !== false`,
  `true === $value`,
  `false === $value`,
  `!!$value`,
  `Boolean($value)`
} as $conversion where {
  register_diagnostic(span=$conversion, message="Conversão manual para boolean é proibida (=== true, !!x, Boolean(x)): o valor tem que chegar como boolean, validado na borda.")
}
