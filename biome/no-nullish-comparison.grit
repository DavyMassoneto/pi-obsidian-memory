language js

or {
  `$value === undefined`,
  `$value !== undefined`,
  `$value == undefined`,
  `$value != undefined`,
  `undefined === $value`,
  `undefined !== $value`,
  `$value === null`,
  `$value !== null`,
  `$value == null`,
  `$value != null`,
  `null === $value`,
  `null !== $value`,
  `typeof $value === "undefined"`,
  `typeof $value !== "undefined"`
} as $comparison where {
  register_diagnostic(span=$comparison, message="Comparação com undefined ou null é proibida: o tipo exato vem de um schema na borda ou de um resultado explícito ({ succeeded: true, output }).")
}
