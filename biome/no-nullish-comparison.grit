language js

or {
  `$value === undefined`,
  `$value !== undefined`,
  `$value == undefined`,
  `$value != undefined`,
  `undefined === $value`,
  `undefined !== $value`,
  `$value === null`,
  `$value !== null`,
  `$value == null`,
  `$value != null`,
  `null === $value`,
  `null !== $value`,
  `typeof $value === "undefined"`,
  `typeof $value !== "undefined"`
} as $comparison where {
  register_diagnostic(span=$comparison, message="Comparing with undefined or null is forbidden: the exact type comes from a schema at the boundary or from an explicit result ({ succeeded: true, output }).")
}
