language js

JsModuleSource() as $source where {
  $source <: or {
    r".\./index\.ts.",
    r".\./[^/]+/.*",
    r".\.\./.*"
  },
  $source <: not r".\.\./index\.ts.",
  register_diagnostic(span=$source, message="Another folder is imported through its barrel with #/ (#/domain/note); from the same folder, import the file (./file.ts), never ./index.ts; ../index.ts only when it creates no cycle.")
}
