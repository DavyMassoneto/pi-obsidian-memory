language js

JsModuleSource() as $source where {
  $source <: or {
    r".\.\./[^.].*",
    r".\./index\.ts.",
    r".\./[^/]+/.*"
  },
  $source <: not r".\.\./index\.ts.",
  register_diagnostic(span=$source, message="Import de outra pasta vem do barrel mais alto (../index.ts); da mesma pasta, importe o arquivo direto (./arquivo.ts), nunca o ./index.ts.")
}
