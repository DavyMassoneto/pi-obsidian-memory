language js

or {
  `$receiver.$method($arguments)` as $style where {
    $method <: or {
      `fg`,
      `bg`,
      `bold`,
      `italic`,
      `underline`,
      `inverse`,
      `strikethrough`
    },
    register_diagnostic(span=$style, message="Estilo (theme.fg, theme.bold…) fica no styles.ts do módulo.")
  },
  JsModuleSource() as $source where {
    $source <: r".(?:chalk|picocolors|kleur|colorette|ansi-colors|ansi-styles).",
    register_diagnostic(span=$source, message="Biblioteca de cor só é importada no styles.ts do módulo.")
  }
}
