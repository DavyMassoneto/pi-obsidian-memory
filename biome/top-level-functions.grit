language js

JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=$value)) as $declarator where {
  $value <: or {
    JsArrowFunctionExpression(),
    JsFunctionExpression()
  },
  $declarator <: not within or {
    JsFunctionBody(),
    JsBlockStatement(),
    JsStaticInitializationBlockClassMember()
  } ,
  register_diagnostic(span=$name, message="Função no topo do módulo usa function nome() {}: com barrels há import circular, e só a declaração com function já existe quando o módulo começa a rodar.")
}
