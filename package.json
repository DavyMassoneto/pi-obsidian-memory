{
  "name": "pi-obsidian-memory",
  "version": "0.0.1",
  "description": "Long-term memory for the pi coding agent, stored in Obsidian vaults",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "obsidian",
    "memory",
    "agent-memory"
  ],
  "license": "MIT",
  "author": "DavyMassoneto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/pi-obsidian-memory.git"
  },
  "homepage": "https://github.com/DavyMassoneto/pi-obsidian-memory#readme",
  "bugs": {
    "url": "https://github.com/DavyMassoneto/pi-obsidian-memory/issues"
  },
  "type": "module",
  "imports": {
    "#domain": "./src/domain/index.ts",
    "#services": "./src/services/index.ts",
    "#usecases": "./src/usecases/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
