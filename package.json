{
  "name": "pi-obsidian-memory",
  "version": "0.0.1",
  "description": "Long-term memory for the pi coding agent, stored in Obsidian vaults",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "obsidian",
    "memory",
    "agent-memory"
  ],
  "license": "MIT",
  "author": "DavyMassoneto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/pi-obsidian-memory.git"
  },
  "homepage": "https://github.com/DavyMassoneto/pi-obsidian-memory#readme",
  "bugs": {
    "url": "https://github.com/DavyMassoneto/pi-obsidian-memory/issues"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*/index.ts",
    "#test-helpers": "./tests/helpers/index.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "skills"
  ],
  "scripts": {
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:model": "vitest run --project model",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.19.1",
    "@types/stopword": "2.0.3",
    "semantic-release": "25.0.9",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "fflate": "0.8.3",
    "stopword": "3.1.5",
    "ulid": "3.0.2",
    "yaml": "2.9.1"
  }
}
